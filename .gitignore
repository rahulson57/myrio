# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production build
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test / coverage
coverage/
test-results/
playwright-report/
blob-report/

# SQLite database (runtime + WAL/SHM sidecars); reseedable, never committed
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal

# Local uploads (runtime-written); seed corpus assets are tracked separately
public/uploads/*
!public/uploads/.gitkeep

# Env / secrets
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
*.log

# OS / editor cruft
.DS_Store
.vscode/
.idea/
