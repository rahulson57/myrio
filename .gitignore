# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production build
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Test / coverage
coverage/
test-results/
playwright-report/
blob-report/

# SQLite database (runtime + WAL/SHM sidecars); reseedable, never committed
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal

# Local uploads (runtime-written); seed corpus assets are tracked separately.
# Un-ignore the seed/ directory node itself (and .gitkeep) so git still
# recurses into them — a bare "!public/uploads/seed/photo.png" would not
# work here because excluding the parent directory blocks recursion into it.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/seed/

# Env / secrets
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
*.log

# OS / editor cruft
.DS_Store
.vscode/
.idea/
